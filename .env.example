# ---------------------------------------------------------------- database
# Neon or Vercel Postgres pooled connection string, keep ?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Origin NextAuth signs callbacks against, set to your domain in production
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- admin seed
# Read by `npm run db:seed` to create the single admin user, set these in Vercel rather than committing them
ADMIN_EMAIL="you@example.com"

ADMIN_PASSWORD="a-long-password-you-will-remember"

ADMIN_NAME="Adossi Fred William"

# ---------------------------------------------------------------- media storage
# Vercel Blob: Project > Storage > Blob > connect, then run `vercel env pull`
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ---------------------------------------------------------------- public site
# Absolute origin used for canonical URLs and OpenGraph images
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
